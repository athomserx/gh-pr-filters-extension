{
  "manifest_version": 3,
  "name": "GH PR Filters",
  "version": "0.0.0",
  "description": "Filter files in GitHub pull requests by CODEOWNERS owner and viewed state.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
